{
  "rewrites": [
    { "source": "/encuesta", "destination": "/encuesta.html" },
    { "source": "/e/:slug", "destination": "/encuesta.html?s=:slug" },
    { "source": "/app", "destination": "/portal.html" },
    { "source": "/app/:path*", "destination": "/portal.html" },
    { "source": "/admin", "destination": "/portal.html" },
    { "source": "/admin/:path*", "destination": "/portal.html" },
    { "source": "/invite", "destination": "/invite.html" }
  ]
}
